ENVIRONMENT=development
DEBUG=false
DATABASE_URL=sqlite:///./finpath.db
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Set this to the configured first administrator owner email.
ADMIN_OWNER_EMAIL=
# Temporary backend-only secret for first-owner setup (minimum 32 characters); remove after setup.
ADMIN_BOOTSTRAP_TOKEN=
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:5500
RESET_TOKEN_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
MODEL_PATH=
MODEL_VERSION=
